# Copy to .env and adjust. .env must not be committed.

# Host ports. Chosen so this project can run beside Project Y (API 8100, Postgres 5442).
DB_HOST_PORT=5452
API_HOST_PORT=8200

POSTGRES_USER=fs
POSTGRES_PASSWORD=fs_dev_password
POSTGRES_DB=field_sales

ENVIRONMENT=development

# Password reset email. Sender domain must be verified in Resend.
MAIL_PROVIDER=disabled
RESEND_API_KEY=
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=My Mariomed
